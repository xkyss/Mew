<Project>
    <PropertyGroup>
        <Product>Mew</Product>
        <Authors>xkyss</Authors>
        <Copyright>Copyright 2023-$([System.DateTime]::Now.Year) (c) xkyss</Copyright>
        <Version>0.2.1</Version>
    </PropertyGroup>

    <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
        <!-- Windows 跑 UI：沿用 .build（文档与 fallback 注释均以此为准） -->
        <MewBuildRoot>$(MSBuildProjectDirectory)\..\..\.build\</MewBuildRoot>
    </PropertyGroup>
    <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
        <!-- 非 Windows（WSL/Linux 仅跑编译与测试）：产物隔离，避免与 Windows 侧中间文件互踩 -->
        <MewBuildRoot>$(MSBuildProjectDirectory)/../../.build-linux/</MewBuildRoot>
    </PropertyGroup>
    <PropertyGroup>
        <BaseIntermediateOutputPath>$(MewBuildRoot)$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
        <BaseOutputPath>$(MewBuildRoot)$(MSBuildProjectName)\bin\</BaseOutputPath>
        <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
        <PackageOutputPath>$(MewBuildRoot)nupkg</PackageOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>$(MSBuildProjectName).Test</_Parameter1>
            <_Parameter1>LINQPadQuery</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
</Project>
