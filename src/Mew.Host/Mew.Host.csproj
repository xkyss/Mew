<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Mew.Host</RootNamespace>
    <AssemblyName>Mew.Host</AssemblyName>
    <ApplicationIcon>..\..\assets\mew-launcher-icon.ico</ApplicationIcon>
    <MewUIBackend>Direct2D</MewUIBackend>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mew.Workbench\Mew.Workbench.csproj" />
    <ProjectReference Include="..\Mew.Launcher\Mew.Launcher.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aprillz.MewUI" Version="0.19.1" />
    <PackageReference Include="Aprillz.MewUI.MewDock" Version="0.19.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

</Project>
