<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Mew.Launcher</RootNamespace>
    <AssemblyName>Mew.Launcher</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mew.Launcher.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mew.Workbench\Mew.Workbench.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aprillz.MewUI" Version="0.19.1" />
    <PackageReference Include="Aprillz.MewUI.MewDock" Version="0.19.1" />
  </ItemGroup>

</Project>
